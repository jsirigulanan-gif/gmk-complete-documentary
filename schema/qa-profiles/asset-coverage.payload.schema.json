{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmk://schema/v1/qa-profile/asset-coverage",
  "type": "object",
  "required": [
    "beats"
  ],
  "properties": {
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beat_ref",
          "semantic",
          "duration",
          "production_ready_segment_refs"
        ],
        "properties": {
          "beat_ref": {
            "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef"
          },
          "semantic": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "$ref": "gmk://schema/v1/asset-common#/$defs/CoverageState"
              }
            },
            "additionalProperties": false
          },
          "duration": {
            "type": "object",
            "required": [
              "basis",
              "required_seconds",
              "unique_visual_seconds"
            ],
            "properties": {
              "basis": {
                "$ref": "gmk://schema/v1/asset-common#/$defs/DurationBasis"
              },
              "required_seconds": {
                "type": "number",
                "minimum": 0
              },
              "unique_visual_seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "production_ready_segment_refs": {
            "type": "array",
            "items": {
              "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
