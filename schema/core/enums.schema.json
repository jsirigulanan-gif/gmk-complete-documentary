{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmk://schema/v1/enums",
  "title": "GMK Shared Enums",
  "$defs": {
    "ObjectType": {
      "type": "string",
      "enum": [
        "PROJECT",
        "ACT",
        "SCENE",
        "NARRATION_BEAT",
        "SOURCE",
        "CLAIM",
        "EVIDENCE",
        "CONTRADICTION",
        "RESEARCH_GAP",
        "SEARCH",
