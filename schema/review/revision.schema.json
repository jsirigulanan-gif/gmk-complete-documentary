{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmk://schema/v1/revision",
  "title": "GMK Revision",
  "allOf": [
    {
      "$ref": "gmk://schema/v1/common#/$defs/BaseObject"
    },
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "REVISION"
        },
        "id": {
          "type": "string",
          "pattern": "^REV_[A-Z0-9_-]+$"
        },
        "reason": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "HUMAN_EDIT_REQUEST",
                "QA_REPAIR",
                "STALE_REPAIR",
                "DEPENDENCY_UPDATE",
                "FACTUAL_CORRECTION",
                "RIGHTS_CORRECTION",
                "PRODUCTION_REFINEMENT"
              ]
            }
          },
          "additionalProperties": false
        },
        "edit_request_refs": {
          "type": "array",
          "items": {
            "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef",
            "x-gmk-dependency-relation": "CONSTRAINS"
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "changed_paths",
              "summary"
            ],
            "properties": {
              "from": {
                "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef",
                "x-gmk-dependency-relation": "DERIVED_FROM"
              },
              "to": {
                "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef"
              },
              "changed_paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "preserved_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HC_[A-Z0-9_-]+$"
          }
        },
        "impact": {
          "$ref": "gmk://schema/v1/reference#/$defs/ArtifactRef"
        },
        "workflow_state": {
          "type": "string",
          "enum": [
            "PLANNED",
            "APPLIED",
            "FAILED",
            "REVERTED"
          ]
        }
      },
      "required": [
        "reason",
        "changes",
        "preserved_constraints",
        "workflow_state"
      ]
    }
  ],
  "unevaluatedProperties": false
}
