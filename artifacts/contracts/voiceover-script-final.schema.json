              "beat_ref",
              "decision_sha256",
              "narration_text"
            ],
            "properties": {
              "beat_ref": {
                "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef",
                "x-gmk-dependency-relation": "FACT_SOURCE"
              },
              "decision_sha256": {
                "$ref": "gmk://schema/v1/reference#/$defs/Sha256"
              },
              "narration_text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_ref",
        "language",
        "blocks"
      ]
    }
  ],
  "unevaluatedProperties": false
