{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmk://schema/v1/artifact/production-lock-review-package",
  "title": "PRODUCTION_LOCK_REVIEW_PACKAGE",
  "allOf": [
    { "$ref": "gmk://schema/v1/artifact-common#/$defs/ArtifactRecord" },
    {
      "type": "object",
      "properties": {
        "artifact_type": { "const": "PRODUCTION_LOCK_REVIEW_PACKAGE" },
        "scope": {
          "type": "object",
          "required": ["type", "project_ref"],
          "properties": {
            "type": { "const": "PROJECT_PRODUCTION_LOCK" },
            "project_ref": { "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef" }
          },
          "additionalProperties": false
        },
        "scene_previews": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ArtifactRef", "x-gmk-dependency-relation": "DERIVED_FROM" }
        },
        "scene_plans": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ArtifactRef", "x-gmk-dependency-relation": "DERIVED_FROM" }
        },
        "voice_locks": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ArtifactRef", "x-gmk-dependency-relation": "TIMING_SOURCE" }
        },
        "design_dna_refs": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef", "x-gmk-dependency-relation": "DESIGN_SOURCE" }
        },
        "shots": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef", "x-gmk-dependency-relation": "RENDER_INPUT" }
        },
        "layers": {
          "type": "array",
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef", "x-gmk-dependency-relation": "RENDER_INPUT" }
        },
        "cues": {
          "type": "array",
          "items": { "$ref": "gmk://schema/v1/reference#/$defs/ObjectRef", "x-gmk-dependency-relation": "RENDER_INPUT" }
        },
        "closure_sha256": { "$ref": "gmk://schema/v1/reference#/$defs/Sha256" },
        "review_summary": {
          "type": "object",
          "required": ["scene_count", "shot_count", "layer_count", "cue_count"],
          "properties": {
            "scene_count": { "type": "integer", "minimum": 1 },
            "shot_count": { "type": "integer", "minimum": 1 },
            "layer_count": { "type": "integer", "minimum": 0 },
            "cue_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "scope", "scene_previews", "scene_plans", "voice_locks", "design_dna_refs",
        "shots", "layers", "cues", "closure_sha256", "review_summary"
      ]
    }
  ],
  "unevaluatedProperties": false
}
